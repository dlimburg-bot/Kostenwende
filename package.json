{
  "name": "kostenwende",
  "private": true,
  "type": "module",
  "description": "Kostenwende – Website (docs/) mit Qualitäts- und Freigabeprozess",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:update-baseline": "playwright test --grep @visual --update-snapshots",
    "lh": "node scripts/lighthouse.mjs",
    "smoke:live": "BASE_URL=https://dlimburg-bot.github.io/Kostenwende/ playwright test --grep @smoke",
    "qa": "node scripts/qa.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "lighthouse": "12.2.1"
  },
  "engines": { "node": ">=20" }
}
